# Configure Keycloak as a PUBLIC OIDC client (Authorization Code + PKCE S256)
VITE_KEYCLOAK_URL=https://dev.auth.piosphere.ai
VITE_KEYCLOAK_REALM=pioone
VITE_KEYCLOAK_CLIENT_ID=pioone-web
# Default (recommended): real Keycloak only
VITE_AUTH_MODE=keycloak
# Local UI preview only (no authentication): VITE_AUTH_MODE=demo
